# Copie para .env e ajuste conforme necessário: cp .env.example .env

# --- PostgreSQL ---
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=meu_projeto_ruby_development
DATABASE_NAME_TEST=meu_projeto_ruby_test
DATABASE_PORT=5434            # porta no host (5432/5433 costumam estar ocupadas)

# --- Portas publicadas no host ---
FRONTEND_PORT=3000           # Nuxt
BACKEND_PORT=3001            # Rails API

# --- Integração frontend <-> backend ---
# O navegador só acessa o Nuxt (porta 3000). O Nuxt faz proxy de /api -> backend.
CORS_ORIGINS=http://localhost:3000
NUXT_API_INTERNAL=http://backend:3000        # alvo do proxy /api (rede Docker)

# --- Usuário do container (arquivos gerados pertencem ao seu usuário) ---
UID=1000
GID=1000

# --- Autenticação ---
# Chave para assinar os JWT. Sem ela, usa Rails.application.secret_key_base.
# JWT_SECRET_KEY=
