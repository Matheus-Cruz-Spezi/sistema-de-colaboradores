{
	"name": "Sistema Colaborador",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],
	"service": "backend",
	"workspaceFolder": "/app",
	"forwardPorts": [3000, 3001, 5432],
	"customizations": {
		"vscode": {
			"extensions": [
				"Shopify.ruby-lsp",
				"KoichiSasada.vscode-rdbg",
				"Vue.volar"
			]
		}
	},
	"postCreateCommand": "bundle install"
}
